---
import { MAX_EMAIL } from '../lib/contact'
import { turnstileSiteKey } from '../lib/turnstile-client'
import { siteConfig } from '../site.config'

const siteKey = turnstileSiteKey(
    siteConfig.turnstileSiteKey,
    import.meta.env.DEV,
)
---

<form
    id="newsletter"
    class="form"
    method="POST"
    action="/api/newsletter"
    aria-labelledby="newsletter-heading"
    hidden
>
    <h2 id="newsletter-heading">Subscribe</h2>
    <div>
        <label for="newsletter-email">Your email</label>
        <input
            id="newsletter-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength={MAX_EMAIL}
            required
        />
    </div>
    <div class="honeypot" aria-hidden="true">
        <label for="newsletter-website">Leave this empty</label>
        <input
            id="newsletter-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
        />
    </div>
    <div id="newsletter-turnstile" data-sitekey={siteKey}></div>
    <div>
        <button type="submit" class="button">Subscribe</button>
    </div>
    <p id="newsletter-status" class="form-status" role="status" hidden></p>
</form>

<script>
    import { loadTurnstile, resetTurnstile } from '../lib/turnstile-client'

    const form = document.getElementById('newsletter') as HTMLFormElement | null
    const container = document.getElementById('newsletter-turnstile')
    const status = document.getElementById('newsletter-status')

    if (form && container && status) {
        // The form needs JavaScript (Turnstile), so it starts hidden; the
        // provider's own page, when configured, is the no-JS path.
        form.hidden = false
        const button = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        )
        let widgetId: string | undefined

        const show = (text: string) => {
            status.textContent = text
            status.hidden = false
        }

        loadTurnstile()
            .then((turnstile) => {
                widgetId = turnstile.render(container, {
                    sitekey: container.dataset.sitekey as string,
                    action: 'newsletter',
                    appearance: 'interaction-only',
                })
            })
            .catch(() => {
                show('The bot check could not load. Reload the page to try again.')
            })

        form.addEventListener('submit', async (event) => {
            event.preventDefault()
            if (button) button.disabled = true
            status.hidden = true
            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                })
                if (res.status === 429) {
                    show('One signup per hour, please. Try again later.')
                    return
                }
                if (!res.ok) throw new Error(String(res.status))
                form.reset()
                show(
                    "Thanks. Unless you're already subscribed, a confirmation email is on its way; you're subscribed once you confirm it.",
                )
            } catch {
                show('Something went wrong. Try again in a moment.')
            } finally {
                resetTurnstile(widgetId)
                if (button) button.disabled = false
            }
        })
    }
</script>
