---
import { MAX_MESSAGE, MAX_NAME } from '../lib/contact'
import { turnstileSiteKey } from '../lib/turnstile-client'
import { siteConfig } from '../site.config'

const siteKey = turnstileSiteKey(
    siteConfig.turnstileSiteKey,
    import.meta.env.DEV,
)
---

<form
    id="contact"
    class="form"
    method="POST"
    action="/api/contact"
    aria-labelledby="contact-heading"
    hidden
>
    <h2 id="contact-heading">Send a message</h2>
    <div>
        <label for="contact-name">Name <span class="hint">(optional)</span></label>
        <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength={MAX_NAME}
        />
    </div>
    <div>
        <label for="contact-email">Your email</label>
        <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
        />
    </div>
    <div>
        <label for="contact-message">Message</label>
        <textarea
            id="contact-message"
            name="message"
            rows="6"
            maxlength={MAX_MESSAGE}
            required></textarea>
    </div>
    <div class="honeypot" aria-hidden="true">
        <label for="contact-website">Leave this empty</label>
        <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
        />
    </div>
    <div id="contact-turnstile" data-sitekey={siteKey}></div>
    <div>
        <button type="submit" class="button">Send</button>
    </div>
    <p id="contact-status" class="form-status" role="status" hidden></p>
</form>

<script>
    import { loadTurnstile, resetTurnstile } from '../lib/turnstile-client'

    const form = document.getElementById('contact') as HTMLFormElement | null
    const container = document.getElementById('contact-turnstile')
    const status = document.getElementById('contact-status')

    if (form && container && status) {
        // The form needs JavaScript (Turnstile), so it starts hidden; the
        // email address on the page is the no-JS path.
        form.hidden = false
        const button = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
        )
        let widgetId: string | undefined

        const show = (text: string) => {
            status.textContent = text
            status.hidden = false
        }

        loadTurnstile()
            .then((turnstile) => {
                widgetId = turnstile.render(container, {
                    sitekey: container.dataset.sitekey as string,
                    action: 'contact',
                    appearance: 'interaction-only',
                })
            })
            .catch(() => {
                show(
                    'The bot check could not load. Reload the page, or email us instead.',
                )
            })

        form.addEventListener('submit', async (event) => {
            event.preventDefault()
            if (button) button.disabled = true
            status.hidden = true
            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                })
                if (res.status === 429) {
                    show(
                        'One message per hour, please. Try again later or email us.',
                    )
                    return
                }
                if (!res.ok) throw new Error(String(res.status))
                form.reset()
                show("Thanks, your message is on its way. We'll reply by email.")
            } catch {
                show(
                    'Something went wrong sending that. Try again, or email us instead.',
                )
            } finally {
                resetTurnstile(widgetId)
                if (button) button.disabled = false
            }
        })
    }
</script>
