---
import { googleEnabled, googlePlan } from '../lib/analytics'
---

{
    googleEnabled && googlePlan && (
        <section
            class="consent-banner"
            aria-labelledby="consent-title"
            data-consent-banner
            data-tag-kind={googlePlan.kind}
            data-tag-id={googlePlan.id}
            hidden
        >
            <h2 id="consent-title">Analytics cookies</h2>
            <p>
                We'd like to use Google Analytics to understand how the site is
                used. It sets cookies on your device and sends usage data to
                Google. Nothing is sent unless you accept. Details are in our{' '}
                <a href="/privacy">privacy policy</a>.
            </p>
            <div class="consent-actions">
                <button type="button" data-consent="granted">
                    Accept
                </button>
                <button type="button" data-consent="denied">
                    Decline
                </button>
            </div>
        </section>
    )
}

<script>
    import {
        effectiveConsent,
        readConsent,
        shouldShowBanner,
        writeConsent,
    } from '../lib/consent'
    import type { ConsentChoice } from '../lib/consent'
    import { loadGoogleTag, withdrawGoogleTag } from '../lib/google-loader'
    import type { GoogleTagPlan } from '../lib/google-tag'

    const banner = document.querySelector<HTMLElement>('[data-consent-banner]')
    if (banner) {
        const plan: GoogleTagPlan = {
            kind: banner.dataset.tagKind as GoogleTagPlan['kind'],
            id: banner.dataset.tagId as string,
        }
        const reopen = document.querySelectorAll<HTMLElement>(
            '[data-consent-reopen]',
        )
        const gpc =
            (navigator as Navigator & { globalPrivacyControl?: boolean })
                .globalPrivacyControl === true

        let storage: Storage | null = null
        try {
            storage = window.localStorage
        } catch {
            storage = null
        }

        const stored = readConsent(storage)
        if (effectiveConsent(stored, gpc) === 'granted') loadGoogleTag(plan)
        banner.hidden = !shouldShowBanner(true, stored, gpc)
        // A GPC signal is already a decline; there is nothing to reopen.
        for (const button of reopen) button.hidden = gpc

        for (const button of banner.querySelectorAll<HTMLButtonElement>(
            '[data-consent]',
        )) {
            button.addEventListener('click', () => {
                const choice = button.dataset.consent as ConsentChoice
                writeConsent(storage, choice)
                if (choice === 'granted') loadGoogleTag(plan)
                else withdrawGoogleTag(plan)
                banner.hidden = true
            })
        }

        for (const button of reopen) {
            button.addEventListener('click', () => {
                banner.hidden = false
                banner.querySelector<HTMLElement>('[data-consent]')?.focus()
            })
        }
    }
</script>
