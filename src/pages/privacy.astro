---
import Legal from '../layouts/Legal.astro'
import {
    analyticsSummary,
    contextAnalytics,
    googlePlan,
    posthogHost,
} from '../lib/analytics'
import { contextOrigin } from '../lib/context'
import { providers } from '../lib/newsletter'
import { siteConfig } from '../site.config'

// Template copy, not legal advice: review it with counsel before launch and
// keep it in step with what the site actually does (see README). The
// analytics wording below follows the build's own configuration.
// Per context (W10): what runs on the site being read, and on a
// multi-context site a list of what runs on each of the others.
const { context, contexts, production } = Astro.locals
const multiContext = contexts.length > 1
const { google: googleEnabled, posthog: posthogEnabled } =
    contextAnalytics(context)
const siteUrl = multiContext
    ? contextOrigin(Astro.url, context, production)
    : siteConfig.url
const siteName = multiContext ? context.name : siteConfig.name
const perSite = contexts.map((c) => ({
    host: c.host,
    summary: analyticsSummary(contextAnalytics(c)),
}))
const posthogDomain = new URL(posthogHost).host
const anyAnalytics = googleEnabled || posthogEnabled
const host = siteConfig.subProcessors[0]?.name ?? 'our hosting provider'
const newsletterProvider = providers[siteConfig.newsletter.provider]
---

<Legal
    title="Privacy"
    description={`How ${siteName} handles your data: cookies, storage, analytics and your rights.`}
>
    <p>
        Welcome to {siteName}. This page explains, in plain language, what
        {siteConfig.entity} collects when you visit {siteUrl}, and what we
        don't.
    </p>
    {
        multiContext && (
            <p>
                The same policy covers all of our sites:{' '}
                {perSite.map((s) => s.host).join(', ')}. Cookies and storage
                belong to each site separately, and the analytics differ by
                site (see Analytics below).
            </p>
        )
    }

    <h2>What are cookies?</h2>
    <p>
        Cookies are small files a website asks your browser to keep. Some are
        essential to make a feature work; others are used for tracking or
        analytics.
    </p>

    <h2>Cookies we use</h2>
    {
        googleEnabled ? (
            <>
                <p>
                    <strong>
                        Until you accept analytics, we set no cookies.
                    </strong>{' '}
                    If you accept, Google Analytics sets:
                </p>
                <ul>
                    <li>
                        <code>_ga</code> and <code>_ga_&lt;id&gt;</code>: tell
                        one visit from another so Google Analytics can count
                        them. They last up to two years.
                        {googlePlan?.kind === 'gtm' &&
                            ' Tags run through Google Tag Manager may set further cookies; we keep this list in step with the tags we run.'}
                    </li>
                </ul>
                <p>
                    You can change your mind at any time with "Cookie settings"
                    in the footer. Declining or withdrawing removes these
                    cookies.
                </p>
            </>
        ) : (
            <p>
                <strong>
                    If you're just reading the site, we set no cookies.
                </strong>
            </p>
        )
    }
    <p>
        People who edit the site's content (editors) sign in to an admin area.
        For them only, the site sets these essential cookies, all cleared when
        the browser session ends:
    </p>
    <ul>
        <li>
            <code>astro-session</code>: keeps you signed in. Only readable by
            the server.
        </li>
        <li>
            <code>__em_d1_bookmark</code>: tells the database which of your
            changes it has already seen, so you see your own edits straight
            away. Only readable by the server.
        </li>
        <li>
            <code>emdash_oauth_csrf</code>: protects the sign-in flow against
            forged requests. Only set while signing in with an external
            provider, and only readable by the server.
        </li>
    </ul>

    <h2>Local storage</h2>
    <p>
        Local storage keeps small preferences in your browser. They are never
        sent to us.
    </p>
    <ul>
        <li>
            <code>theme</code>: your light or dark choice from the theme
            switch. Not stored if you leave it on "System".
        </li>
        {
            googleEnabled && (
                <li>
                    <code>consent</code>: whether you accepted or declined
                    analytics cookies, so we don't keep asking.
                </li>
            )
        }
        <li>
            Editors only: <code>emdash-editor</code>,
            <code>emdash-toolbar-labels</code> and (if you dismiss the toolbar)
            <code>emdash-toolbar-dismissed</code> remember editing-toolbar
            preferences.
        </li>
    </ul>

    <h2>Managing cookies and storage</h2>
    <p>
        You can view and clear cookies and site data at any time in your
        browser settings: see the help pages for
        <a href="https://support.google.com/chrome/answer/95647">Chrome</a>,
        <a
            href="https://support.mozilla.org/kb/clear-cookies-and-site-data-firefox"
            >Firefox</a
        >,
        <a href="https://support.apple.com/guide/safari/sfri11471/mac"
            >Safari</a
        >
        and
        <a
            href="https://support.microsoft.com/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09"
            >Edge</a
        >. Clearing them won't break the public site.
    </p>

    <h2>Analytics</h2>
    {!anyAnalytics && <p>This site doesn't use analytics.</p>}
    {
        multiContext && (
            <>
                <p>What runs on each of our sites:</p>
                <ul data-analytics-per-site>
                    {perSite.map((s) => (
                        <li>
                            {s.host}: {s.summary}
                        </li>
                    ))}
                </ul>
                <p>The rest of this section describes {context.host}.</p>
            </>
        )
    }
    {
        googleEnabled && (
            <>
                <p>
                    We use Google Analytics{googlePlan?.kind === 'gtm' && ' through Google Tag Manager'}
                    to understand how the site is used, but only if you accept.{' '}
                    <strong>
                        Until you accept, nothing is sent to Google and its
                        scripts aren't even loaded.
                    </strong>{' '}
                    If you accept, Google receives usage data about your visit:
                    the pages you view, where you came from, your approximate
                    location, your device, browser and operating system, and
                    an identifier stored in the cookies above. We don't send
                    Google your name or email address.
                </p>
                <p>
                    A browser sending the Global Privacy Control signal is
                    treated as a decline, and we don't ask. Google's own
                    handling of the data is described in
                    <a href="https://policies.google.com/technologies/partner-sites"
                        >how Google uses information from sites that use its
                        services</a
                    >.
                </p>
            </>
        )
    }
    {
        posthogEnabled && (
            <>
                <p>
                    We also use PostHog ({posthogDomain}) for simple, aggregate
                    analytics, in its cookieless mode: nothing is stored on your
                    device. It collects page URLs, referrer, country or region,
                    device type, browser and operating system, and nothing that
                    identifies you.
                </p>
            </>
        )
    }
    <p>
        Like any website, our host ({host}) sees your IP address when your
        browser asks for a page, and may keep short-term operational logs to
        keep the site running and secure.
    </p>
    {
        siteConfig.contact.enabled && (
            <>
                <h2>Contact form</h2>
                <p>
                    The contact page loads Cloudflare Turnstile from{' '}
                    <code>challenges.cloudflare.com</code> to check that a
                    person, not a bot, is sending the form. It runs only on that
                    page and only with JavaScript on. To do that check,
                    Cloudflare receives your IP address and signals about your
                    browser; see{' '}
                    <a href="https://www.cloudflare.com/turnstile-privacy-policy/"
                        >Cloudflare's Turnstile privacy addendum</a
                    >.
                </p>
                <p>
                    When you send the form, your message, your email address and
                    your name (if you give one) are emailed to us through
                    Cloudflare Email Sending, from the same host that serves the
                    site. To limit abuse, the site keeps a
                    one-way hash of your IP address for one hour, which can't be
                    turned back into the address.
                </p>
            </>
        )
    }
    {
        siteConfig.newsletter.enabled && (
            <>
                <h2>Newsletter</h2>
                <p>
                    Pages with a newsletter signup form load Cloudflare
                    Turnstile from <code>challenges.cloudflare.com</code> to
                    check that a person, not a bot, is signing up. It runs only
                    on those pages and only with JavaScript on. To do that check, Cloudflare
                    receives your IP address and signals about your browser;
                    see{' '}
                    <a href="https://www.cloudflare.com/turnstile-privacy-policy/"
                        >Cloudflare's Turnstile privacy addendum</a
                    >.
                </p>
                <p>
                    When you subscribe, the site sends your email address and IP
                    address to {newsletterProvider.name}, which sends the
                    newsletter and keeps the subscriber list. It uses your IP
                    address to keep out spam signups. You're only added once you
                    confirm the email it sends you, and every newsletter has an
                    unsubscribe link. See{' '}
                    <a href={newsletterProvider.privacyUrl}
                        >{newsletterProvider.name}'s privacy policy</a
                    >. To limit abuse, the site keeps a one-way hash of your IP
                    address for one hour, which can't be turned back into the
                    address.
                </p>
            </>
        )
    }

    <h2>Editors and signed-in users</h2>
    <p>
        If you're given an editor account, we store your name, email address,
        role and the public part of your passkey (or other sign-in method) in
        the site's database. Your fingerprint or face data never leaves your
        device. Content you write is stored with the site's content. Sign-in
        links and invitations are emailed to you through Cloudflare Email
        Sending.
    </p>

    <h2>Data retention</h2>
    <ul>
        <li>Cookies: only as long as described above.</li>
        <li>Local storage: until you clear it in your browser.</li>
        {
            siteConfig.contact.enabled && (
                <li>
                    Contact messages: in our inbox until no longer needed, or
                    until you ask us to delete them. The hashed IP address: one
                    hour.
                </li>
            )
        }
        {
            siteConfig.newsletter.enabled && (
                <li>
                    Newsletter: with {newsletterProvider.name} until you
                    unsubscribe or ask us to delete it. The hashed IP address:
                    one hour.
                </li>
            )
        }
        {
            googleEnabled && (
                <li>
                    Google Analytics: kept under the data-retention setting of
                    our Google Analytics property.
                </li>
            )
        }
        {
            posthogEnabled && (
                <li>
                    PostHog: aggregate events are kept under the retention
                    settings of our PostHog project.
                </li>
            )
        }
        <li>Editor accounts: while the account exists.</li>
    </ul>

    <h2>Your rights</h2>
    {
        googleEnabled ? (
            <p>
                If you accept analytics, Google Analytics collects usage data
                about your visit under a pseudonymous identifier, which the law
                may treat as personal data. You can withdraw your consent at any
                time with "Cookie settings" in the footer, clear your cookies
                and storage, and ask us what we hold. Editors can also ask us to
                correct or delete their account details.
            </p>
        ) : (
            <p>
                You can see how your data is handled (this page), clear your
                storage and cookies whenever you like, and ask us about it.
                Since we don't collect personal data about visitors, there is
                typically nothing to export or delete. Editors can ask us to
                correct or delete their account details.
            </p>
        )
    }
    <p>
        Depending on where you live, you may have further rights under laws
        like the GDPR or CCPA. Email us and we'll answer within 30 days.
    </p>

    <h2>Contact</h2>
    <p>
        Questions or requests: <a href={`mailto:${siteConfig.privacyEmail}`}
            >{siteConfig.privacyEmail}</a
        >.
    </p>

    <h2>Changes to this policy</h2>
    <p>
        If we change this policy we'll update the date at the top. The date and
        site version shown there tell you which text you're reading.
    </p>
</Legal>
