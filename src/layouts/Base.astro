---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from 'emdash'
import { createPublicPageContext } from 'emdash/page'
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from 'emdash/ui'
import ConsentBanner from '../components/ConsentBanner.astro'
import Footer from '../components/Footer.astro'
import HeadMeta from '../components/HeadMeta.astro'
import PostHog from '../components/PostHog.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { contextOrigin } from '../lib/context'
import { contextIdentity } from '../lib/discovery'
import { businessSchema, toJsonLdScript } from '../lib/structured-data'
import { siteConfig } from '../site.config'
import '../styles/global.css'
import { resolveStarterSiteIdentity } from '../utils/site-identity'

interface Props {
    title: string
    pageTitle?: string | null
    description?: string | null
    image?: string | null
    canonical?: string | null
    /** Pass content reference for plugin page contributions on content pages */
    content?: { collection: string; id: string; slug?: string | null }
    /** Extra JSON-LD for this page (e.g. faqSchema()); the business is always included. */
    jsonLd?: unknown[]
}

const {
    title,
    pageTitle,
    description,
    image,
    canonical,
    content,
    jsonLd = [],
} = Astro.props
// The request's context (src/middleware.ts). On a multi-context site it
// names the page, the JSON-LD and og:site_name; one context changes nothing.
const { context, contexts, production } = Astro.locals
const multiContext = contexts.length > 1
const structuredData = [
    businessSchema(contextIdentity(siteConfig, context, contexts)),
    ...jsonLd.filter(Boolean),
]
const [settingsResult, menuResult] = await Promise.all([
    getSiteSettingsWithCacheHint(),
    getMenuWithCacheHint('primary'),
])
if (Astro.cache?.enabled) {
    Astro.cache.set(settingsResult.cacheHint)
    Astro.cache.set(menuResult.cacheHint)
}

const identity = resolveStarterSiteIdentity(settingsResult.data)
const { siteLogo } = identity
const siteTitle = multiContext ? context.name : identity.siteTitle
const siteTagline = multiContext ? context.description : identity.siteTagline
const titleIncludesSiteName =
    title === siteTitle ||
    title.endsWith(` | ${siteTitle}`) ||
    title.endsWith(` - ${siteTitle}`)
const fullTitle = titleIncludesSiteName ? title : `${title} - ${siteTitle}`
const pageDescription = description ?? siteTagline
const menu = menuResult.data

const pageCtx = createPublicPageContext({
    Astro,
    kind: content ? 'content' : 'custom',
    pageType: 'website',
    title: fullTitle,
    pageTitle: pageTitle ?? title,
    description: pageDescription,
    canonical,
    image,
    content,
    siteName: siteTitle,
    siteUrl: multiContext
        ? contextOrigin(Astro.url, context, production)
        : undefined,
})
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<HeadMeta />
		{!context.indexable && <meta name="robots" content="noindex" />}
		<PostHog />
		{
			structuredData.map((data) => (
				<script
					type="application/ld+json"
					is:inline
					set:html={toJsonLdScript(data)}
				/>
			))
		}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<a class="skip-link" href="#main">Skip to content</a>

		<SiteHeader siteTitle={siteTitle} siteLogo={siteLogo} menu={menu}>
			<slot name="header-actions" slot="actions" />
		</SiteHeader>

		<main id="main">
			<slot />
		</main>

		<Footer />
		<ConsentBanner />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
