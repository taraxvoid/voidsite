{
    "name": "voidsite",
    "version": "0.0.3",
    "private": true,
    "license": "MIT",
    "type": "module",
    "emdash": {
        "label": "Starter",
        "seed": "seed/seed.json"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "deploy": "astro build && wrangler deploy",
        "typecheck": "astro check",
        "check": "astro check",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test:unit": "vitest run",
        "test:e2e": "aube run build:e2e && PUBLIC_GA_MEASUREMENT_ID=G-E2ETEST123 playwright test",
        "test:e2e:a11y": "playwright test test/e2e/a11y.spec.ts",
        "check:licenses": "node scripts/check-licenses.ts",
        "audit": "aube audit --audit-level high",
        "prepare": "husky",
        "lint:actions": "sh scripts/lint-actions.sh",
        "test:push": "aube run lint && aube run check && aube run test:unit && aube run test:e2e",
        "build:e2e": "PUBLIC_GA_MEASUREMENT_ID=G-E2ETEST123 astro build",
        "check:placeholders": "node scripts/check-placeholders.ts",
        "build:e2e:gtm": "PUBLIC_GTM_ID=GTM-E2ETEST123 astro build",
        "test:e2e:gtm": "aube run build:e2e:gtm && PUBLIC_GTM_ID=GTM-E2ETEST123 playwright test test/e2e/consent-gtm.spec.ts test/e2e/legal.spec.ts",
        "test:e2e:editor": "sh scripts/test-editor-e2e.sh"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.3.1",
        "@astrojs/react": "^6.0.5",
        "@emdash-cms/cloudflare": "^1.0.1",
        "astro": "^7.3.2",
        "emdash": "^1.0.1",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.13.0",
        "@biomejs/biome": "^2.5.14",
        "@cloudflare/workers-types": "^5.20260820.1",
        "@lizenz/checker": "^0.0.2",
        "@playwright/test": "^1.63.0",
        "husky": "^9.1.7",
        "vitest": "^5.0.2",
        "wrangler": "^4.142.0"
    },
    "packageManager": "aube@2.7.0",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.18.0",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=24.18.0"
    }
}
