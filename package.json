{
    "name": "chantilly",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "emdash": {
        "label": "Starter",
        "seed": "seed/seed.json"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "deploy": "astro build && wrangler deploy",
        "typecheck": "astro check",
        "check": "astro check",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test:unit": "vitest run",
        "test:e2e": "pnpm run build:e2e && PUBLIC_GA_MEASUREMENT_ID=G-E2ETEST123 playwright test",
        "test:e2e:a11y": "playwright test test/e2e/a11y.spec.ts",
        "check:licenses": "node scripts/check-licenses.ts",
        "audit": "pnpm audit --audit-level high",
        "prepare": "husky",
        "lint:actions": "sh scripts/lint-actions.sh",
        "test:push": "pnpm run lint && pnpm run check && pnpm run test:unit && pnpm run test:e2e",
        "build:e2e": "PUBLIC_GA_MEASUREMENT_ID=G-E2ETEST123 astro build",
        "check:placeholders": "node scripts/check-placeholders.ts",
        "build:e2e:gtm": "PUBLIC_GTM_ID=GTM-E2ETEST123 astro build",
        "test:e2e:gtm": "pnpm run build:e2e:gtm && PUBLIC_GTM_ID=GTM-E2ETEST123 playwright test test/e2e/consent-gtm.spec.ts test/e2e/legal.spec.ts"
    },
    "dependencies": {
        "@astrojs/cloudflare": "^14.3.1",
        "@astrojs/react": "^6.0.5",
        "@emdash-cms/cloudflare": "^1.0.1",
        "astro": "^7.3.2",
        "emdash": "^1.0.1",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@axe-core/playwright": "^4.13.0",
        "@biomejs/biome": "^2.5.14",
        "@cloudflare/workers-types": "^5.20260820.1",
        "@lizenz/checker": "^0.0.2",
        "@playwright/test": "^1.63.0",
        "husky": "^9.1.7",
        "vitest": "^5.0.2",
        "wrangler": "^4.142.0"
    },
    "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
    "volta": {
        "node": "24.18.0",
        "pnpm": "11.9.0"
    },
    "engines": {
        "node": ">=24.18.0"
    }
}
