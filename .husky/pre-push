#!/bin/sh

# Skip the checks when the push carries no commits the remote doesn't already
# have (branch delete, tag on a pushed commit, new branch at a pushed commit).
# Same idea as voidflow's lefthook/site.yml pre-push, but compared against
# every ref of the remote instead of only the ref being updated.
has_new_commits=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if [ -n "$(git rev-list -n 1 "$local_sha" --not --remotes="$1" 2>/dev/null)" ]; then
    has_new_commits=true
  fi
done
if [ "$has_new_commits" = false ]; then
  echo "pre-push: no new commits to push, skipping checks"
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "pre-push: 'node_modules' is missing. Run 'pnpm install', then push again."
  exit 1
fi

pnpm run test:push
